// =====================================================
// 공통 파라미터 — 풀리 내장형 벨트 감속 관절 모듈 (회전축 구조)
// 좌표 규약:
//  - 베이스 플레이트 윗면 = z 0 (베이스는 z -base_t .. 0)
//  - 출력축(스트리퍼 볼트) 중심 = (0, 0)
//  - 모터축 중심 = (-axis_dist, 0)
//  - 암은 +x 방향(모터 반대쪽)으로 뻗는다
//
// 구조 요약: 스트리퍼 볼트가 "회전축". 608ZZ 2개는 베이스 일체
// 하향 보스(외륜 고정)에 들어가고, 볼트+내륜+풀리+허브가 M6 너트
// 축력으로 한 덩어리로 클램프되어 함께 회전한다.
//
// OpenSCAD 커스터마이저 그룹으로 구성. 파생 치수(z 좌표 등)는
// [Hidden] 섹션에서 계산하므로 직접 수정하지 않는다.
// =====================================================

/* [전역 배치] */
// 폐루프 GT2 벨트 길이 — 축간거리 C를 자동 역산 (280=기본 C99.2, 200=컴팩트 C58.6)
belt_len = 280; // [200, 260, 280, 300]
// 베이스 플레이트 두께
base_t    = 8;

/* [베이스 플레이트] */
// 프레임 장착 M4 관통홀 지름
mount_hole_d = 4.5;

/* [베어링 하우징 — 608ZZ ×2, 베이스 일체 하향 보스] */
// 608ZZ 외경
brg_od   = 22;
// 608ZZ 내경
brg_id   = 8;
// 608ZZ 폭
brg_w    = 7;
// 내륜 스페이서 외경 (스케이트 베어링 스페이서 8×10×10)
skate_od = 10;
// 내륜 스페이서 길이 = 외륜 웹 두께
skate_l  = 10;
// 하향 보스 외경 (포켓 Ø22 + 벽 5)
boss_od  = 32;

/* [회전축 — 스트리퍼 볼트 + M6 나일록] */
// 쇼울더부 길이 (Ø8) — 적층 합계보다 짧아야 함
shoulder_l  = 55;
// M6 나사부 길이 (표준 쇼울더볼트 고정값)
m6_thread_l = 10;
// 볼트 머리 지름
bolt_head_d = 13;
// 볼트 머리 높이
bolt_head_h = 5.5;
// M6 나일록 너트 폭간 (DIN985)
nut_m6_af   = 10;
// M6 나일록 너트 높이
nut_m6_h    = 6;

/* [평와셔 — 위치별 기성품 규격, DESIGN.md 수지 계산표와 대조할 것] */
// 머리측 와셔 외경 (M8×15×1.6 — 외륜 내경 Ø17.8 미접촉)
head_washer_od = 15;
// 머리측 와셔 두께
head_washer_t  = 1.6;
// 중간 와셔 외경 (M8×15×1.6 — 상부 내륜~풀리 사이)
mid_washer_od  = 15;
// 중간 와셔 두께
mid_washer_t   = 1.6;
// 상부 와셔 외경 (M6×22×2.0 광폭 — 프린팅 허브 면압 분산)
top_washer_od  = 22;
// 상부 와셔 두께
top_washer_t   = 2.0;
// 상부 와셔 내경 (M6 나사부 구간이라 6.4)
top_washer_id  = 6.4;

/* [출력 풀리 GT2 60T — 실측과 대조할 것] */
// 이빨 외경 (PD 38.2 − 0.5)
p60_od       = 37.7;
// 플랜지 지름
p60_flange_d = 44;
// 플랜지 두께
p60_flange_t = 1.0;
// 세트스크류 보스 지름 (하향)
p60_boss_d   = 32;
// 세트스크류 보스 높이
p60_boss_h   = 6.5;
// 보어 (Ø8 쇼울더 슬라이드 끼움)
p60_bore     = 8.2;
// 이빨부 높이
p60_teeth_h  = 7.2;

/* [암 허브 / 암] */
// 허브 디스크 외경 (= 암 허브측 폭, 서포트 프리)
hub_od    = 32;
// 허브 높이 — 적층 55.9 > 쇼울더 55 (심 없이 +0.9 수지)
hub_h     = 13;
// 허브 축 보어 (쇼울더 슬라이드 끼움)
hub_bore  = 8.3;
// 암 길이 (축 중심 → 끝단 홀 중심)
arm_len   = 85;
// 암 허브측 폭
arm_w     = 32;
// 암 끝단 폭 (테이퍼)
arm_w_tip = 18;

/* [벨트 GT2] */
// 벨트 폭
belt_w = 6;
// 벨트 두께
belt_t = 1.5;

/* [모터 NEMA 17] */
// 몸체 한 변
nema_side       = 42.3;
// 몸체 길이 (베이스 아래 매달림)
nema_len        = 40;
// 체결홀 피치 (M3 4개, 정사각)
nema_hole_pitch = 31;
// 전면 위치결정 보스 지름
nema_boss_d     = 22;
// 위치결정 보스 높이
nema_boss_h     = 2;
// 모터축 지름
nema_shaft_d    = 5;
// 모터축 끝 높이 (축 길이 22mm 기준, 베이스 윗면 기준)
nema_shaft_top  = 14;

/* [입력 풀리 GT2 20T] */
// 이빨 외경 근사
p20_od       = 12.2;
// 플랜지 지름
p20_flange_d = 18;
// 세트스크류 보스 지름
p20_boss_d   = 16;
// 세트스크류 보스 높이
p20_boss_h   = 6.5;
// 보스 하단 높이 (벨트 정렬 조정 — 이빨부가 출력측과 맞도록)
p20_z0       = 1.4;
// 이빨부 높이
p20_teeth_h  = 7.6;

/* [모터 슬롯 / 잭 스크류] */
// 모터 체결 장공 폭 (M3용)
slot_w      = 3.4;
// 모터 체결 장공 길이 (조절 범위 ±5.3mm)
slot_l      = 14;
// 센터 보스 장공 폭
boss_slot_w = 22.5;
// 센터 보스 장공 길이
boss_slot_l = 34.5;
// 잭 블록 크기 [x, y, z] (베이스 하면 아래 — 모터 몸체와 같은 높이)
jack_block  = [10, 14, 14];

/* [Hidden] */

// ---- 벨트 길이 → 축간거리 역산 ----
// 2C + π(D+d)/2 + (D−d)²/(4C) = L 을 C에 대해 풀이
p60_pd = 60 * 2 / PI;                   // 출력 풀리 PD 약 38.2
p20_pd = 20 * 2 / PI;                   // 입력 풀리 PD 약 12.7
_belt_rem = belt_len - PI * (p60_pd + p20_pd) / 2;   // L − 감김 호 길이 80
axis_dist = (_belt_rem + sqrt(_belt_rem * _belt_rem
            - 2 * (p60_pd - p20_pd) * (p60_pd - p20_pd))) / 4;  // 280→99.2, 200→58.6
// 컴팩트 배치 전환 — C가 짧으면 웨이스트 없이 모터 패드가 윙에 직결
compact_base = axis_dist < 81;

// ---- 베이스 ----
// 프레임 장착홀 좌표 (패싯 윤곽 꼭짓점은 motor_side.scad의 _base_pts 참조)
// 컴팩트는 웨이스트 홀이 없어 3점
mount_holes = compact_base
    ? [[-axis_dist - 23.8, 0], [20, 28], [20, -28]]
    : [[-axis_dist - 23.8, 0], [-axis_dist + 58.2, 0], [20, 28], [20, -28]];

// ---- 베어링 하우징 z 배치 — 고정부 ----
// 상부 608은 베이스 판 두께 안, 하부 608은 하향 보스 안.
// 외륜 사이 웹(ID20)이 양방향 축하중을 폼클로저로 받는다.
brgA_z0 = -brg_w;                       // 상부 베어링 z -7..0 (윗면과 면일치)
web_h   = skate_l;                      // 외륜 웹 두께 = 내륜 스페이서 10
brgB_z0 = brgA_z0 - web_h - brg_w;      // 하부 베어링 z -24..-17
spacer_z0 = brgB_z0 + brg_w;            // 내륜 스페이서 z -17..-7
boss_z0 = brgB_z0 - 1;                  // 보스 하단 z -25 (포켓 입구 여유 1)

// ---- 회전 적층 (아래→위, 스트리퍼 볼트 머리 하향) ----
// 머리 / 와셔 / 하부내륜 / 스페이서 / 상부내륜 / 와셔 / 풀리 / 허브
// / 광폭와셔 / M6 나일록 — 너트를 조이면 전체가 한 덩어리로 회전
shoulder_z0   = brgB_z0 - head_washer_t;     // -25.6
shoulder_z1   = shoulder_z0 + shoulder_l;    // 29.4 (M6 나사부 29.4..39.4)

// ---- 출력 풀리 z 배치 (보스 하향, 무가공) ----
// 8mm bore가 Ø8 쇼울더에 직접 끼워져 센터링. 토크는 적층 클램프
// 마찰이 주경로, 보스 세트스크류(축에 직결)가 백업 + 조립 시 가고정.
p60_z0   = brgA_z0 + brg_w + mid_washer_t;   // 1.6 — 중간 와셔 위
p60_fl1_z0   = p60_z0 + p60_boss_h;          // 하부 플랜지 z 8.1..9.1
p60_teeth_z0 = p60_fl1_z0 + p60_flange_t;    // 이빨부 z 9.1..16.3
p60_fl2_z0   = p60_teeth_z0 + p60_teeth_h;   // 상부 플랜지 z 16.3..17.3
p60_z1   = p60_fl2_z0 + p60_flange_t;        // 풀리 상단 z 17.3
p60_screw_z = p60_z0 + p60_boss_h / 2;       // 보스 세트스크류 z 4.85 (축을 묾)
p60_screw_angles = [0, 90];

// ---- 암 허브 / 암 z 배치 — 단순 디스크, 적층에 클램프 ----
// 베어링 보어 없음. Ø8.3 보어로 쇼울더에 끼워지고, 너트 축력이
// 허브~풀리 상부 플랜지 면압(마찰)으로 토크를 전달한다.
hub_z0  = p60_z1;                       // 17.3 — 풀리 상부 플랜지 위
hub_z1  = hub_z0 + hub_h;               // 30.3
arm_z0 = hub_z1 - 6;  arm_z1 = hub_z1;  // 암 z 24.3..30.3
arm_slots = [[20, 36, 12], [42, 56, 10], [62, 74, 7]];  // 경량화 트러스 컷 [x0,x1,폭]

// 적층 상단 체결 (광폭 와셔 → 너트, 모두 허브 위)
// 와셔 내경 6.4 — 쇼울더 끝(29.4)이 허브 보어 안에 0.9mm 묻혀 간섭 없음
top_washer_z0 = hub_z1;                      // 30.3..32.3
nut_z0 = top_washer_z0 + top_washer_t;       // 32.3..38.3 (나사부 29.4..39.4 안)

// ---- 벨트 경로 ----
belt_z0 = p60_teeth_z0 + (p60_teeth_h - belt_w) / 2;   // 9.7 → z 9.7..15.7

// ---- 입력 풀리 z 배치 (보스 하향) ----
p20_fl1_z0   = p20_z0 + p20_boss_h;          // 하부 플랜지 z 7.9..8.9
p20_teeth_z0 = p20_fl1_z0 + 1;               // 이빨부 z 8.9..16.5 (벨트 9.7..15.7 정렬)
p20_z1   = p20_teeth_z0 + p20_teeth_h + 1;   // 풀리 상단 z 17.5

// ---- 잭 스크류 배치 ----
jack_block_x = -axis_dist + 32;         // 모터 앞쪽(출력 풀리 쪽) 블록 중심 x
jack_z = -base_t - jack_block[2] / 2;   // 스크류 축 높이 z -15

// ---- 색상 — 회전부(주황/웜 계열) vs 고정부(블루/그레이 계열) ----
// 회전축 구조: 볼트·내륜·스페이서·와셔·너트가 모두 회전 → 웜 톤온톤
// 고정부는 베이스·보스·외륜만 남음
c_stat   = [0.36, 0.46, 0.62];          // 고정 프린팅 부품 (베이스+보스)
c_steel  = [0.75, 0.76, 0.78];          // 고정 금속 (베어링 외륜·모터 볼트 등)
c_axle   = [0.84, 0.64, 0.38];          // 회전 축 (스트리퍼 볼트)
c_nut    = [0.70, 0.50, 0.28];          // 너트 (웜 진함)
c_washer = [0.97, 0.90, 0.76];          // 평와셔 (웜 밝음)
c_alu    = [0.92, 0.80, 0.62];          // 내륜 스페이서
c_move   = [0.93, 0.53, 0.12];          // 회전 프린팅 (암 허브/암)
c_move_m = [0.88, 0.63, 0.30];          // 회전 금속 (풀리·베어링 내륜)
c_belt   = [0.15, 0.15, 0.15];
c_motor  = [0.25, 0.25, 0.28];

// 색 적용 헬퍼 — $ghost_alpha(단면 고스트 투명도)를 동적 전파받음
module tinted(c) {
    color(c, is_undef($ghost_alpha) ? 1 : $ghost_alpha) children();
}

$fa = 4; $fs = 0.4;
