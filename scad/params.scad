// =====================================================
// 공통 파라미터 — 풀리 내장형 벨트 감속 관절 모듈 (회전축 구조)
// 좌표 규약:
//  - 베이스 플레이트 윗면 = z 0 (베이스는 z -base_t .. 0)
//  - 출력축(스트리퍼 볼트) 중심 = (0, 0)
//  - 모터축 중심 = (-axis_dist, 0)
//  - 암은 +x 방향(모터 반대쪽)으로 뻗는다
//
// 구조 요약: 스트리퍼 볼트가 "회전축". 608ZZ 2개는 베이스 일체
// 하향 보스(외륜 고정)에 들어가고, 볼트+내륜+풀리+허브가 M6 너트
// 축력으로 한 덩어리로 클램프되어 함께 회전한다.
// =====================================================

axis_dist = 99.2;     // 축간거리 C
base_t    = 8;        // 베이스 플레이트 두께

// ---- 베이스 플레이트 외형 ----
// 패싯(각면) 윤곽: 모터 패드(45° 챔퍼) + 테이퍼 웨이스트 + 출력 패싯/스웹트 윙
// 꼭짓점 좌표는 motor_side.scad의 _base_pts 참조
mount_hole_d = 4.5;                        // 프레임 장착 M4 관통홀
mount_holes  = [[-123, 0], [-41, 0], [20, 28], [20, -28]];

// ---- 베어링 하우징 (베이스 일체 하향 보스) — 고정부 ----
// 상부 608은 베이스 판 두께 안, 하부 608은 하향 보스 안.
// 외륜 사이 웹(ID20)이 양방향 축하중을 폼클로저로 받는다.
brg_od = 22; brg_id = 8; brg_w = 7;     // 608ZZ
skate_od = 10; skate_l = 10;            // 스케이트 베어링 스페이서 8x10x10
brgA_z0 = -brg_w;                       // 상부 베어링 z -7..0 (윗면과 면일치)
web_h   = skate_l;                      // 외륜 웹 두께 = 내륜 스페이서 10
brgB_z0 = brgA_z0 - web_h - brg_w;      // 하부 베어링 z -24..-17
spacer_z0 = brgB_z0 + brg_w;            // 내륜 스페이서 z -17..-7
boss_od = 32;                           // 하향 보스 외경 (포켓 Ø22 + 벽 5)
boss_z0 = brgB_z0 - 1;                  // 보스 하단 z -25 (포켓 입구 여유 1)

// ---- 회전 적층 (아래→위, 스트리퍼 볼트 머리 하향) ----
// 머리 / 와셔 / 하부내륜 / 스페이서 / 상부내륜 / 와셔 / 풀리 / 허브
// / 광폭와셔 / M6 나일록 — 너트를 조이면 전체가 한 덩어리로 회전
// 와셔는 위치별 기성품 (심 와셔 폐지 — 허브 13mm 증육으로 수지 흡수)
head_washer_od = 15;  head_washer_t = 1.6;  // M8×15×1.6 머리측 (외륜 Ø17.8 미접촉)
mid_washer_od  = 15;  mid_washer_t  = 1.6;  // M8×15×1.6 상부 내륜~풀리 사이
top_washer_od  = 22;  top_washer_t  = 2.0;  // M6×22×2.0 허브 위 광폭 (면압 분산)
top_washer_id  = 6.4;                       // 이 높이는 M6 나사부 구간 — M6 내경
shoulder_l    = 55;
shoulder_z0   = brgB_z0 - head_washer_t;     // -25.6
shoulder_z1   = shoulder_z0 + shoulder_l;    // 29.4
m6_thread_l   = 10;                     // 표준 쇼울더볼트 나사 길이 (29.4..39.4)
bolt_head_d   = 13;  bolt_head_h = 5.5;
nut_m6_af     = 10;  nut_m6_h = 6;      // M6 나일록 (DIN985)

// ---- 출력 풀리 GT2 60T (8mm bore, 보스 하향, 무가공) ----
// 8mm bore가 Ø8 쇼울더에 직접 끼워져 센터링. 토크는 적층 클램프
// 마찰이 주경로, 보스 세트스크류(축에 직결)가 백업 + 조립 시 가고정.
p60_pd   = 60 * 2 / PI;                 // 약 38.2
p60_od   = 37.7;                        // 이빨 외경 (PD - 0.5)
p60_flange_d = 44;  p60_flange_t = 1.0;
p60_boss_d   = 32;  p60_boss_h   = 6.5; // 세트스크류 보스 (아래로)
p60_bore = 8.2;                         // Ø8 쇼울더 슬라이드 끼움
p60_z0   = brgA_z0 + brg_w + mid_washer_t;   // 1.6 — 중간 와셔 위
p60_fl1_z0   = p60_z0 + p60_boss_h;          // 하부 플랜지 z 8.1..9.1
p60_teeth_z0 = p60_fl1_z0 + p60_flange_t;    // 이빨부 z 9.1..16.3
p60_teeth_h  = 7.2;
p60_fl2_z0   = p60_teeth_z0 + p60_teeth_h;   // 상부 플랜지 z 16.3..17.3
p60_z1   = p60_fl2_z0 + p60_flange_t;        // 풀리 상단 z 17.3
p60_screw_z = p60_z0 + p60_boss_h / 2;       // 보스 세트스크류 z 4.85 (축을 묾)
p60_screw_angles = [0, 90];

// ---- 암 허브 / 암 — 단순 디스크, 적층에 클램프 ----
// 베어링 보어 없음. Ø8.3 보어로 쇼울더에 끼워지고, 너트 축력이
// 허브~풀리 상부 플랜지 면압(마찰)으로 토크를 전달한다.
hub_od  = 32;                           // = 암 허브측 폭 (서포트 프리)
hub_z0  = p60_z1;                       // 17.3 — 풀리 상부 플랜지 위
hub_h   = 13;                           // 적층 55.9 > 쇼울더 55 (심 없이 +0.9 수지)
hub_z1  = hub_z0 + hub_h;               // 30.3
hub_bore = 8.3;
arm_len   = 85;
arm_w     = 32;                         // 허브측 폭 (= hub_od)
arm_w_tip = 18;                         // 끝단 폭 (테이퍼)
arm_z0 = hub_z1 - 6;  arm_z1 = hub_z1;  // 암 z 24.3..30.3
arm_slots = [[20, 36, 12], [42, 56, 10], [62, 74, 7]];  // 경량화 트러스 컷 [x0,x1,폭]

// 적층 상단 체결 (광폭 와셔 → 너트, 모두 허브 위)
// 와셔 내경 6.4 — 쇼울더 끝(29.4)이 허브 보어 안에 0.9mm 묻혀 간섭 없음
top_washer_z0 = hub_z1;                      // 30.3..32.3
nut_z0 = top_washer_z0 + top_washer_t;       // 32.3..38.3 (나사부 29.4..39.4 안)

// ---- 벨트 GT2-280, 6mm 폭 ----
belt_w  = 6;
belt_t  = 1.5;
belt_z0 = p60_teeth_z0 + (p60_teeth_h - belt_w) / 2;   // 9.7 → z 9.7..15.7
p20_pd  = 20 * 2 / PI;                  // 약 12.7

// ---- NEMA 17 + 20T 풀리 (보스 하향) ----
nema_side   = 42.3;
nema_len    = 40;                       // 몸체 z -48..-8 (베이스 아래 매달림)
nema_hole_pitch = 31;                   // M3 4개, 정사각
nema_boss_d = 22;   nema_boss_h = 2;
nema_shaft_d = 5;
nema_shaft_top = 14;                    // 축 길이 22mm 기준 (베이스 윗면 기준)
p20_od   = 12.2;                        // 이빨 외경 근사
p20_flange_d = 18;
p20_boss_d = 16;  p20_boss_h = 6.5;
p20_z0   = 1.4;                              // 보스 하단
p20_fl1_z0   = p20_z0 + p20_boss_h;          // 하부 플랜지 z 7.9..8.9
p20_teeth_z0 = p20_fl1_z0 + 1;               // 이빨부 z 8.9..16.5 (벨트 9.7..15.7 정렬)
p20_teeth_h  = 7.6;
p20_z1   = p20_teeth_z0 + p20_teeth_h + 1;   // 풀리 상단 z 17.5

// ---- 모터 슬롯 / 잭 스크류 ----
slot_w = 3.4;  slot_l = 14;             // 장축 x 방향, 조절 범위 ±5.3mm
boss_slot_w = 22.5; boss_slot_l = 34.5;
jack_block_x = -axis_dist + 32;         // 모터 앞쪽(출력 풀리 쪽) 블록 중심 x
jack_block = [10, 14, 14];              // 블록 크기 (베이스 하면 아래 — 모터 몸체와 같은 높이)
jack_z = -base_t - jack_block[2] / 2;   // 스크류 축 높이 z -15

// ---- 색상 — 회전부(주황/웜 계열) vs 고정부(블루/그레이 계열) ----
// 회전축 구조: 볼트·내륜·스페이서·와셔·너트가 모두 회전 → 웜 톤온톤
// 고정부는 베이스·보스·외륜만 남음
c_stat   = [0.36, 0.46, 0.62];          // 고정 프린팅 부품 (베이스+보스)
c_steel  = [0.75, 0.76, 0.78];          // 고정 금속 (베어링 외륜·모터 볼트 등)
c_axle   = [0.84, 0.64, 0.38];          // 회전 축 (스트리퍼 볼트)
c_nut    = [0.70, 0.50, 0.28];          // 너트 (웜 진함)
c_washer = [0.97, 0.90, 0.76];          // 평와셔 (웜 밝음)
c_alu    = [0.92, 0.80, 0.62];          // 내륜 스페이서
c_move   = [0.93, 0.53, 0.12];          // 회전 프린팅 (암 허브/암)
c_move_m = [0.88, 0.63, 0.30];          // 회전 금속 (풀리·베어링 내륜)
c_belt   = [0.15, 0.15, 0.15];
c_motor  = [0.25, 0.25, 0.28];

// 색 적용 헬퍼 — $ghost_alpha(단면 고스트 투명도)를 동적 전파받음
module tinted(c) {
    color(c, is_undef($ghost_alpha) ? 1 : $ghost_alpha) children();
}

$fa = 4; $fs = 0.4;
